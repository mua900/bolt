#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_Composition
{
    float4 ambient;
};

struct main0_out
{
    float4 out_var_SV_Target [[color(0)]];
};

struct main0_in
{
    float2 in_var_TEXCOORD0 [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant type_Composition& Composition [[buffer(0)]], texture2d<float> colorTexture [[texture(0)]], texture2d<float> lightTexture [[texture(1)]], sampler colorSampler [[sampler(0)]], sampler lightSampler [[sampler(1)]])
{
    main0_out out = {};
    float4 _32 = colorTexture.sample(colorSampler, in.in_var_TEXCOORD0);
    out.out_var_SV_Target = float4(_32.xyz * (lightTexture.sample(lightSampler, in.in_var_TEXCOORD0).xyz + Composition.ambient.xyz), _32.w);
    return out;
}

